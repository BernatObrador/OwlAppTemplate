<templates xml:space="preserve">
  <t t-name="pages.ContactForm">
    <section class="app-page app-page-narrow">
      <div class="app-page-header"><h1 t-esc="isNew ? 'New contact' : 'Edit contact'"/></div>
      <p t-if="state.loading" role="status">Loading contact…</p>
      <div t-elif="state.loadError" class="app-alert app-alert-danger" role="alert"><p t-esc="state.loadError"/><button class="app-button app-button-ghost" t-on-click="load">Retry</button></div>
      <form t-else="" class="app-card app-form" t-on-submit="save">
        <div t-if="state.saveError" class="app-alert app-alert-danger" role="alert" t-esc="state.saveError"/>
        <FormField name="'name'" label="'Name'" value="state.form.name" required="true" disabled="state.saving" error="state.errors.name" onInput="(value) => this.setField('name', value)"/>
        <FormField name="'email'" label="'Email'" type="'email'" value="state.form.email" disabled="state.saving" error="state.errors.email" onInput="(value) => this.setField('email', value)"/>
        <FormField name="'company'" label="'Company'" value="state.form.company" disabled="state.saving" error="state.errors.company" onInput="(value) => this.setField('company', value)"/>
        <FormField name="'status'" label="'Status'" type="'select'" value="state.form.status" options="statusOptions" disabled="state.saving" error="state.errors.status" onInput="(value) => this.setField('status', value)"/>
        <small t-if="dirty" class="app-muted">Unsaved changes</small>
        <div class="app-form-actions">
          <button class="app-button app-button-ghost" type="button" t-att-disabled="state.saving" t-on-click="cancel">Cancel</button>
          <button class="app-button app-button-ghost" type="button" t-att-disabled="state.saving || !dirty" t-on-click="reset">Reset</button>
          <button class="app-button app-button-primary" type="submit" t-att-disabled="state.saving"><t t-esc="state.saving ? 'Saving…' : 'Save contact'"/></button>
        </div>
      </form>
    </section>
  </t>
</templates>
